  "default_feature_set": "paper_82",
  "training": {
    "train_splits": [
      "train",
      "dev"
    ],
    "test_splits": [
      "test"
    ],
    "log_perplexity": true,
    "clip_low": 0.005,
    "clip_high": 0.995,
    "add_missing_indicators": false,
    "scaler": "maxabs",
    "models": {
      "paper_b0_rho05_vaderfull": {
        "type": "target_logistic_regression",
        "target_params": {
          "Depression_label": {
            "penalty": "l2",
            "C": 0.02,
            "class_weight": "balanced",
            "solver": "liblinear",
            "max_iter": 12000
          },
          "PTSD_label": {
            "penalty": "l2",
            "C": 0.005,
            "class_weight": {
              "0": 1.0,
              "1": 3.2
            },
            "solver": "liblinear",
            "max_iter": 12000
          }
        },
        "fixed_thresholds": {
          "Depression_label": 0.5320324848487864,
          "PTSD_label": 0.5720423927420021
        }
      },
      "normalised_basic": {
        "type": "logistic_regression",
        "params": {
          "penalty": "l2",
          "C": 1.0,
          "class_weight": "balanced",
          "solver": "liblinear",
          "max_iter": 8000
        }
      }
    }
  },
  "metrics": [
    "f1_macro",
    "f1_binary",
    "accuracy",
    "pr_auc",
    "roc_auc"
  ],
  "bootstrap": {
    "enabled": true,
    "n_boot": 2000,
    "alpha": 0.95
